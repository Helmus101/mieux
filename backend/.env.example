# Copy this file to backend/.env if you need to set variables. backend/.env is read when the server starts. Never commit it.
# Mieux uses no language model and needs no API key.

# Supabase is used for sign-in only (optional). The API verifies the access tokens the web app sends.


# Optional: approximate web price lookup. DeepSeek's built-in web search is tried first, then Gemini with Google Search grounding.
# When both find no usable price, DeepSeek's model with server-side web_search is asked for one last cited answer.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# WEBPRICE_AI_DAILY_CAP=100
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
