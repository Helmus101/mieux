# Copy this file to backend/.env if you need to set variables. backend/.env is read when the server starts. Never commit it.
# Mieux's scoring uses no language model. The beta "photo of a product" feature does: set ANTHROPIC_API_KEY to enable it (without it, the endpoint answers 503).
# ANTHROPIC_API_KEY=sk-ant-...
# VISION_MODEL=claude-opus-5-5

# Supabase is used for sign-in only (optional). The API verifies the access tokens the web app sends.

