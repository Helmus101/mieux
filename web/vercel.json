{
  "build": {
    "env": {
      "VITE_SITE_URL": "https://mieuxmanger.vercel.app",
      "VITE_API_BASE_URL": "https://mieux-api.fly.dev/v1"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
