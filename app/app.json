{
  "expo": {
    "name": "Mieux",
    "slug": "mieux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mieux.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Mieux uses the camera to scan product barcodes.",
        "NSPhotoLibraryUsageDescription": "Mieux reads a photo of a barcode you choose."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mieux.mobile",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Mieux uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mieux reads a photo of a barcode you choose."
        }
      ],
      "expo-image"
    ],
    "scheme": "mieux",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://mieux-api.fly.dev/v1",
      "apiPort": 8010
    }
  }
}
