{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "zustand": [
        "./node_modules/zustand"
      ],
      "axios": [
        "./node_modules/axios"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.nosync",
    "dist"
  ]
}